#!/usr/bin/env python3
import sys
sys.dont_write_bytecode = True
from _checks import main
result = main()
if result == 0 and sys.argv[1:] == ["--full"]:
    import subprocess
    from pathlib import Path
    result = subprocess.call([sys.executable, str(Path(__file__).with_name("check-application"))])
sys.exit(result)
